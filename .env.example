NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin used for canonical URLs, sitemap.xml, robots.txt and social cards.
# On Vercel this is inferred from the deployment; set it explicitly once you have
# a custom domain.
NEXT_PUBLIC_SITE_URL=https://spendly-bice-iota.vercel.app

# Google Search Console ownership token. Paste only the `content` value from the
# meta tag Google shows, not the whole tag. Leave unset and no tag is rendered.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
